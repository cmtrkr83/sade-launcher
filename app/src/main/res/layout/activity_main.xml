<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <!-- Başlık: saat + iki satır tarih + sağda Ayarlar düğmesi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:textColor="@color/text_primary"
                android:textSize="42sp"
                tools:text="19:39" />

            <!-- Saatin yüksekliği ikiye bölünmüş gibi: üstte gün+ay, altta haftanın günü -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/date_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    tools:text="19 Ekim" />

                <TextView
                    android:id="@+id/date_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp"
                    tools:text="Pazartesi" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Sistem izleyici: RAM / CPU / Disk halkaları (bağlantı ikonu hizasında) -->
            <com.sade.tvlauncher.SysMonitorView
                android:id="@+id/sys_monitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="20dp"
                android:contentDescription="@string/sys_monitor" />

            <!-- IP adresi (rozet gibi, bağlantı ikonunun solunda) -->
            <TextView
                android:id="@+id/net_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="192.168.1.128" />

            <!-- Bağlantı durumu: ethernet/wifi simgesi, yeşil=bağlı kırmızı=bağlı değil.
                 Yüksekliği Ayarlar düğmesiyle aynı (44dp) → düğmeyle aynı düşey hizada. -->
            <ImageView
                android:id="@+id/net_status"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/net_status"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wifi" />

            <!-- İkonlu Ayarlar düğmesi (D-pad ile odaklanabilir) -->
            <LinearLayout
                android:id="@+id/header_settings"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/icon_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:includeFontPadding="false"
                    android:duplicateParentState="true"
                    android:text="@string/sc_settings"
                    android:textColor="@color/pill_text"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Favoriler -->
        <LinearLayout
            android:id="@+id/favorites_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_favorites" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favorites_row"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <!-- Tüm uygulamalar -->
        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="12dp"
            android:text="@string/section_apps" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/app_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusedByDefault="true"
            tools:targetApi="26"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Taşıma modu ipucu (yalnızca taşırken görünür) -->
    <TextView
        android:id="@+id/move_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_hint"
        android:elevation="6dp"
        android:includeFontPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="@string/move_hint"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>
